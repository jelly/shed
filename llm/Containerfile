FROM docker.io/archlinux:latest
ARG VERSION=2.1.325

ENV DISABLE_UPDATES=1
ENV DISABLE_INSTALLATION_CHECKS=1
ENV CLAUDE_CONFIG_DIR=/claude
ENV GH_CONFIG_DIR=/claude/gh

RUN useradd --uid 1000 --create-home coder

RUN pacman-key --init
RUN pacman -Sy --noconfirm archlinux-keyring
RUN pacman -Syu --needed --noconfirm nodejs python mypy ruff meson meson-python \
                                     python-pytest python-pytest-pacman python-pytest python-pytest-asyncio \
				     pkgconf strace github-cli git socat bubblewrap \
				     uv ty diffutils time npm make rust just gcc zsh && pacman -Scc --noconfirm
RUN curl -o /usr/local/bin/claude "https://downloads.claude.ai/claude-code-releases/$VERSION/linux-x64/claude"
RUN chmod +x /usr/local/bin/claude

USER coder
CMD ["claude"]
